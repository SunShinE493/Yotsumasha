// WordMemoryGame/tsconfig.server.json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", // CommonJS から NodeNext に変更
    "lib": ["ES2022", "DOM"],
    "outDir": "../../dist/server", // WordMemoryGame ディレクトリの外に出力
    "rootDir": ".",               // WordMemoryGame ディレクトリをルートにする
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"]
    },
    "moduleResolution": "bundler", // Node.jsのモジュール解決戦略
    "noEmit": false
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "client",
    "vite.config.ts" // ルートのvite.config.tsは除外
  ]
}