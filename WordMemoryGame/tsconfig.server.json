{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "outDir": "dist/server",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": "./", // <-- この行を追加
    "paths": {
      "@shared/*": ["./shared/*"] // <-- この行を追加
    }
  },
  "include": [
    "server", 
    "shared"
  ]
}