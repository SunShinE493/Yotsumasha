// WordMemoryGame/tsconfig.server.json
{
  "compilerOptions": {
    "target": "ES2022",           // Node.jsのバージョンに合わせて調整 (例: Node 18 -> ES2022)
    "module": "CommonJS",         // Node.jsランタイムに合ったモジュール形式
    "lib": ["ES2022", "DOM"],     // DOMはExpressのRequest/Responseなどで必要になる可能性
    "outDir": "dist/server",
    "rootDir": "./server",        // serverディレクトリをルートとしてコンパイル
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./shared/*"] // sharedディレクトリへのパス
    },
    "moduleResolution": "node",   // Node.jsのモジュール解決戦略
    "noEmit": false
  },
  "include": [
    "server/**/*.ts",             // serverディレクトリ内のすべてのTypeScriptファイル
    "shared/**/*.ts"              // sharedディレクトリ内のすべてのTypeScriptファイル
  ],
  "exclude": [
    "node_modules",
    "dist",                       // ビルド成果物ディレクトリ
    "client",                     // クライアントサイドのコードは除外
    "server/vite.ts",             // 明示的にvite関連ファイルをサーバービルドから除外
    "vite.config.ts"              // vite.config.tsも除外
  ]
}