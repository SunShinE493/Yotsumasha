modules = ["nodejs-16", "nodejs-20"]
run = "npm run start"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WordMemoryGame Server"

[[workflows.workflow]]
name = "WordMemoryGame Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd WordMemoryGame && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
